# Copy to .env. Replace every placeholder with isolated-lab values.

THREATTRACE_DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/threattrace
THREATTRACE_REDIS_URL=redis://YOUR_REDIS_HOST:6379/0
THREATTRACE_DB_POOL_SIZE=10
THREATTRACE_DB_MAX_OVERFLOW=20
THREATTRACE_DB_POOL_TIMEOUT_SECONDS=30
THREATTRACE_DB_POOL_USE_LIFO=true

THREATTRACE_STORAGE_ROOT=runtime_storage
THREATTRACE_MALWARE_ROOT=runtime_storage/malware
THREATTRACE_REPORT_ROOT=runtime_storage/reports
THREATTRACE_MALWARE_ARCHIVE_PASSWORD=CHANGE_ME

THREATTRACE_MALWAREBAZAAR_API_URL=https://mb-api.abuse.ch/api/v1/
THREATTRACE_MALWAREBAZAAR_API_KEY=
THREATTRACE_MALWAREBAZAAR_RECENT_LIMIT=100
THREATTRACE_MALWAREBAZAAR_TAG_LIMIT=100
THREATTRACE_MALWAREBAZAAR_MIN_REQUEST_INTERVAL_SECONDS=1.0
THREATTRACE_MALWAREBAZAAR_CACHE_TTL_SECONDS=300
THREATTRACE_MALWAREBAZAAR_MAX_RETRIES=3
THREATTRACE_MALWAREBAZAAR_DAILY_DOWNLOAD_LIMIT=200

THREATTRACE_MALSHARE_BASE_URL=https://malshare.com/api.php
THREATTRACE_MALSHARE_API_URL=https://malshare.com/api.php
THREATTRACE_MALSHARE_API_KEY=
THREATTRACE_MALSHARE_DOWNLOAD_DIR=runtime_storage/malshare
THREATTRACE_MALSHARE_DAILY_LIMIT=20
THREATTRACE_MALSHARE_TIMEOUT_SECONDS=30
THREATTRACE_MALSHARE_DAILY_API_LIMIT_SAFETY_MARGIN=50

THREATTRACE_CAPE_API_URL=http://YOUR_CAPE_HOST:8080/apiv2
THREATTRACE_CAPE_API_TOKEN=
THREATTRACE_CAPE_STORAGE_PATH=runtime_storage/cape_storage
THREATTRACE_CAPE_MACHINE=YOUR_CAPE_X86_MACHINE
THREATTRACE_CAPE_MACHINE_X86=YOUR_CAPE_X86_MACHINE
THREATTRACE_CAPE_MACHINE_X64=YOUR_CAPE_X64_MACHINE
THREATTRACE_CAPE_PLATFORM=windows
THREATTRACE_CAPE_TAGS_X86=x86
THREATTRACE_CAPE_TAGS_X64=x64
THREATTRACE_CAPE_TIMEOUT_SECONDS=300
THREATTRACE_CAPE_POLL_INTERVAL_SECONDS=60
THREATTRACE_CAPE_POLL_RUNNING_INTERVAL_SECONDS=45
THREATTRACE_CAPE_POLL_MAX_INTERVAL_SECONDS=300
THREATTRACE_CAPE_MAX_WAIT_SECONDS=54000000
THREATTRACE_CAPE_VERIFY_SSL=true

THREATTRACE_VR_X64_NAME=YOUR_VR_X64_VM
THREATTRACE_VR_X64_HOST=YOUR_VR_X64_HOST
THREATTRACE_VR_X64_USER=YOUR_VR_USER
THREATTRACE_VR_X64_PASSWORD=
THREATTRACE_VR_X64_CLIENT_ID=
THREATTRACE_VR_X86_NAME=YOUR_VR_X86_VM
THREATTRACE_VR_X86_HOST=YOUR_VR_X86_HOST
THREATTRACE_VR_X86_USER=YOUR_VR_USER
THREATTRACE_VR_X86_PASSWORD=
THREATTRACE_VR_X86_CLIENT_ID=
THREATTRACE_VR_VALIDATION_SNAPSHOT=YOUR_BASELINE_SNAPSHOT
THREATTRACE_VR_STAGING_BIND_HOST=YOUR_STAGING_HOST
THREATTRACE_VR_VALIDATION_NET=YOUR_VALIDATION_CIDR
THREATTRACE_VR_VALIDATION_BRIDGE=YOUR_VALIDATION_BRIDGE
THREATTRACE_VR_INETSIM_IP=YOUR_INETSIM_IP
THREATTRACE_VR_FRONTEND_IP=YOUR_VR_FRONTEND_IP
THREATTRACE_VR_NETWORK_BACKUP_DIR=runtime_storage/network_backups
THREATTRACE_VR_VELOCIRAPTOR_CONFIG=/path/to/server.config.yaml
THREATTRACE_VR_VELOCIRAPTOR_API_CONFIG=
THREATTRACE_VR_VELOCIRAPTOR_USE_SUDO=false
THREATTRACE_VR_LIBVIRT_URI=qemu:///system
THREATTRACE_VR_WAIT_SECONDS_DEFAULT=900
THREATTRACE_VR_HTTP_PORT_MIN=18000
THREATTRACE_VR_HTTP_PORT_MAX=18999
THREATTRACE_VR_CAPE_BINARY_FALLBACK=runtime_storage/cape_storage/binaries

THREATTRACE_DAILY_BATCH_SIZE=50
THREATTRACE_CELERY_TASK_SOFT_TIMEOUT=1800
THREATTRACE_CELERY_TASK_HARD_TIMEOUT=3600
THREATTRACE_PIPELINE_REQUEUE_DELAY_SECONDS=60
THREATTRACE_PIPELINE_MAX_RETRIES=48
THREATTRACE_LOG_LEVEL=INFO
