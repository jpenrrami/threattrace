{
  "regex": {
    "sha256": "^[a-fA-F0-9]{64}$",
    "url": "https?://[^\\s\\\"'<>]+",
    "ipv4": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
    "domain": "\\b[a-z0-9][a-z0-9.-]{1,253}\\.[a-z]{2,63}\\b",
    "windows_path": "(?:[a-zA-Z]:\\\\[^\\\\\\r\\n\\t\\\"'<>|?*]+(?:\\\\[^\\\\\\r\\n\\t\\\"'<>|?*]+)*)",
    "registry": "(?:hkey_[a-z_]+|hkcu|hklm|hkcr|hku|hkcc|\\\\registry\\\\)[^,\\r\\n\\t\\\"']+",
    "user_agent": "(?:mozilla|curl|wget|python-requests|go-http-client|powershell)/[^\\r\\n\\t\\\"']+"
  },
  "report_hash_entry_path_keys": ["path", "process_path", "module_path"],
  "report_process_path_keys": ["process_path", "module_path"],
  "enhanced_rules": [
    {"object": "registry", "event": "read", "data_key": "regkey", "target": "enhanced_registry_read"},
    {"object": "registry", "event": "write", "data_key": "regkey", "target": "enhanced_registry_write"},
    {"object": "registry", "event": "delete", "data_key": "regkey", "target": "enhanced_registry_delete"},
    {"object": "file", "event": "read", "data_key": "file", "target": "enhanced_file_read"},
    {"object": "file", "event": "write", "data_key": "file", "target": "enhanced_file_write"},
    {"object": "file", "event": "delete", "data_key": "file", "target": "enhanced_file_delete"},
    {"object": "file", "event": "execute", "data_key": "file", "target": "enhanced_file_execute"},
    {"object": "file", "event": "copy", "data_key": "file", "target": "enhanced_file_copy"},
    {"object": "file", "event": "move", "data_key": "file", "target": "enhanced_file_move"},
    {"object": "dir", "event": "create", "data_key": "file", "target": "enhanced_dir_create"},
    {"object": "library", "event": "load", "data_keys": ["pathtofile", "file"], "target": "enhanced_libraries"},
    {"object": "service", "event": "start", "data_key": "service", "target": "enhanced_services"}
  ],
  "bson_notification_templates": {
    "__process__": {"module_path_key": "ModulePath"},
    "__environ__": {"command_line_key": "CommandLine"}
  },
  "bson_field_rules": [
    {"field_names": ["FileName", "HandleName", "DirectoryName", "DosFileName", "ApplicationName", "ProcessFileName", "ImagePathName", "ModulePath", "ModuleName", "DllPath"], "add_path": true},
    {"field_names": ["ApplicationName", "ProcessFileName", "ImagePathName", "ModulePath"], "add_process": true},
    {"field_names": ["CommandLine"], "add_command": true},
    {"field_names": ["ObjectAttributesName", "ObjectAttributes"], "add_registry_if_registry_like": true},
    {"field_names": ["ServiceName"], "add_service": true},
    {"field_names": ["ServerName", "Name", "ip"], "add_domain_or_ip": true},
    {"field_names": ["ObjectName", "NetworkResource"], "add_url_or_domain_or_ip": true},
    {"field_names": ["UserAgent"], "add_user_agent": true}
  ],
  "text_tree_roots": ["sysmon", "browser", "htmldump", "tlsdump"],
  "text_tree_file_suffixes": [".txt", ".log", ".json", ".xml", ".html", ".htm", ".csv"],
  "text_tree_command_tokens": ["cmd.exe", "powershell", "rundll32", "wmic", "schtasks", "regsvr32", "mshta"],
  "pcap_string_files": ["dump.pcap", "dump_mixed.pcap"],
  "analysis_artifact_fields": [
    "analysis_dir",
    "files_json_entries",
    "files_json_categories",
    "files_json_paths",
    "cape_payload_hashes",
    "files_hashes",
    "procdump_hashes",
    "selfextracted_hashes",
    "digisig_valid",
    "digisig_error",
    "digisig_error_desc",
    "digisig_signers",
    "tlsdump_entry_count",
    "reported_file_paths",
    "reported_process_names",
    "reported_process_paths",
    "pcap_sha256",
    "decrypted_pcap_sha256",
    "mixed_pcap_sha256",
    "cape_config_families",
    "enhanced_registry_read",
    "enhanced_registry_write",
    "enhanced_registry_delete",
    "enhanced_file_read",
    "enhanced_file_write",
    "enhanced_file_delete",
    "enhanced_file_execute",
    "enhanced_file_copy",
    "enhanced_file_move",
    "enhanced_dir_create",
    "enhanced_libraries",
    "enhanced_services",
    "bson_process_names",
    "bson_process_paths",
    "bson_command_lines",
    "bson_file_paths",
    "bson_registry_keys",
    "bson_services",
    "bson_domains",
    "bson_ips",
    "bson_urls",
    "bson_user_agents",
    "bson_api_names",
    "bson_log_count",
    "config_urls",
    "config_domains",
    "config_ips",
    "config_file_paths",
    "config_registry_keys",
    "config_user_agents",
    "pcap_domains",
    "pcap_urls",
    "pcap_ips",
    "tree_process_names",
    "tree_process_paths",
    "tree_command_lines"
  ],
  "merged_output_sources": {
    "cape_payload_hashes": ["cape_payload_hashes", "report_json_payload_hashes"],
    "files_hashes": ["files_hashes", "report_json_dropped_hashes"],
    "procdump_hashes": ["procdump_hashes", "report_json_procdump_hashes"],
    "config_urls": ["report_json.config_urls", "pcap.pcap_urls", "tree.tree_urls"],
    "config_domains": ["report_json.config_domains", "bson.bson_domains", "pcap.pcap_domains", "tree.tree_domains"],
    "config_ips": ["report_json.config_ips", "bson.bson_ips", "pcap.pcap_ips", "tree.tree_ips"],
    "config_file_paths": ["report_json.config_file_paths", "pcap.pcap_file_paths", "tree.tree_file_paths"],
    "config_registry_keys": ["report_json.config_registry_keys", "pcap.pcap_registry_keys", "tree.tree_registry_keys"],
    "config_user_agents": ["report_json.config_user_agents", "pcap.pcap_user_agents", "tree.tree_user_agents", "bson.bson_user_agents"]
  }
}
